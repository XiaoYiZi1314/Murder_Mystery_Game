{
  "name": "shisanwu-murder-mystery-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "node --import tsx prisma/seed.ts",
    "bootstrap:boss": "node --import tsx scripts/bootstrap-boss.ts",
    "dev:worker": "node --import tsx --watch src/worker/outbox-worker.ts",
    "dev:test": "node scripts/with-test-env.mjs npm run dev",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@node-rs/argon2": "^2.0.0",
    "@prisma/client": "^6.19.0",
    "@tanstack/react-query": "^5.87.4",
    "antd": "^6.6.3",
    "clsx": "^2.1.1",
    "ioredis": "^5.8.2",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
