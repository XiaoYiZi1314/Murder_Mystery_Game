# Browser-visible origin
NEXT_PUBLIC_APP_URL=http://localhost

# Server-only application configuration
# 开发环境：本机 MySQL80 上的独立 schema；部署(compose)时 HOST 用服务名 mysql
DATABASE_URL=mysql://shisanwu_dev:replace-with-a-strong-password@127.0.0.1:3306/shisanwu_dev
# 集成测试独立库/独立 Redis 逻辑库与键前缀；测试与生产密钥不共用
TEST_DATABASE_URL=mysql://shisanwu_dev:replace-with-a-strong-password@127.0.0.1:3306/shisanwu_test
REDIS_URL=redis://127.0.0.1:6379/0
TEST_REDIS_URL=redis://127.0.0.1:6379/1
REDIS_PREFIX=ssw:
TEST_REDIS_PREFIX=ssw-test:

# Session (server-only)
SESSION_COOKIE_NAME=shisanwu_session
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=604800
SESSION_SECURE_COOKIES=false

# Login rate limiting：同 IP / 同手机号各自 5 次失败 / 10 分钟
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600

# Password hashing (argon2id)；测试环境可降低参数提速，生产不降低
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Docker Compose MySQL bootstrap values（仅部署形态使用）
MYSQL_DATABASE=shisanwu
MYSQL_USER=shisanwu
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password

# Public reverse-proxy port
NGINX_PORT=80

# BOSS 自举（首次部署建店长账号，见 scripts/bootstrap-boss.ts）
# BOSS_PHONE=138xxxxxxxx
# BOSS_PASSWORD=replace-with-a-strong-password
# BOSS_NICKNAME=十三雾店长

# Outbox 投递 worker
OUTBOX_POLL_MS=5000
OUTBOX_BATCH_SIZE=20

# 集成测试目标地址（dev:test 默认本机 3000）
TEST_BASE_URL=http://localhost:3000

# Public and private roots MUST be disjoint; never point private at public/.
STORAGE_DRIVER=local
UPLOAD_PUBLIC_DIR=var/uploads
UPLOAD_PRIVATE_DIR=var/private-media
