generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  dm
  manager
  boss
}

enum UserStatus {
  active
  disabled
}

enum ScriptDifficulty {
  beginner
  intermediate
  advanced
}

enum ScriptStatus {
  draft
  published
  archived
}

enum CostumeStatus {
  available
  maintenance
  retired
}

// C1：草案状态沿用既有集合（小写）；C3 按共享协议 §5 扩展为完整状态机。
enum GameSessionStatus {
  scheduled
  open
  full
  completed
  cancelled
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
}

enum IdempotencyStatus {
  pending
  completed
}

enum OutboxStatus {
  pending
  delivered
  dead
}

model User {
  id            BigInt       @id @default(autoincrement())
  phone         String       @unique @db.VarChar(32)
  nickname      String       @db.VarChar(80)
  passwordHash  String       @db.VarChar(255)
  balance       Decimal      @default(0) @db.Decimal(10, 2)
  points        Int          @default(0)
  totalTopup    Decimal      @default(0) @db.Decimal(10, 2)
  role          UserRole     @default(customer)
  status        UserStatus   @default(active)
  memberLevelId BigInt?
  memberLevel   MemberLevel? @relation(fields: [memberLevelId], references: [id], onDelete: SetNull)
  dmProfile     Dm?
  bookings      Booking[]
  notifications Notification[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([role, status])
  @@index([memberLevelId])
}

model MemberLevel {
  id             BigInt   @id @default(autoincrement())
  code           String   @unique @db.VarChar(32)
  name           String   @db.VarChar(80)
  rank           Int      @unique
  topupThreshold Decimal  @default(0) @db.Decimal(10, 2)
  discountRate   Decimal  @default(1.0000) @db.Decimal(5, 4)
  benefits       Json?
  users          User[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Script {
  id               BigInt           @id @default(autoincrement())
  slug             String           @unique @db.VarChar(191)
  title            String           @db.VarChar(160)
  coverUrl         String           @db.VarChar(2048)
  tagline          String?          @db.VarChar(255)
  synopsis         String           @db.Text
  durationMinutes  Int
  minPlayers       Int
  maxPlayers       Int
  difficulty       ScriptDifficulty
  pricePerPlayer   Decimal          @db.Decimal(10, 2)
  status           ScriptStatus     @default(draft)
  tags             Json?
  sessions         Session[]
  costumes         Costume[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, difficulty])
}

model Dm {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?   @db.Text
  rating    Decimal?  @db.Decimal(3, 2)
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Costume {
  id             BigInt        @id @default(autoincrement())
  name           String        @db.VarChar(160)
  imageUrl       String        @db.VarChar(2048)
  description    String?       @db.Text
  stockTotal     Int           @default(0)
  stockAvailable Int           @default(0)
  status         CostumeStatus @default(available)
  scripts        Script[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
}

model Session {
  id          BigInt            @id @default(autoincrement())
  scriptId    BigInt
  script      Script            @relation(fields: [scriptId], references: [id], onDelete: Restrict)
  dmId        BigInt?
  dm          Dm?               @relation(fields: [dmId], references: [id], onDelete: SetNull)
  startsAt    DateTime
  endsAt      DateTime
  roomName    String            @db.VarChar(80)
  capacity    Int
  status      GameSessionStatus @default(scheduled)
  bookings    Booking[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([scriptId, startsAt])
  @@index([dmId, startsAt])
  @@index([status, startsAt])
}

model Booking {
  id          BigInt        @id @default(autoincrement())
  bookingNo   String        @unique @db.VarChar(40)
  userId      BigInt
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessionId   BigInt
  session     Session       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  playerCount Int
  totalAmount Decimal       @db.Decimal(10, 2)
  status      BookingStatus @default(pending)
  note        String?       @db.VarChar(500)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([sessionId, status])
}

model OperationLog {
  id            BigInt   @id @default(autoincrement())
  actorId       BigInt
  actorRole     UserRole
  action        String   @db.VarChar(100)
  targetType    String   @db.VarChar(60)
  targetId      String   @db.VarChar(60)
  summaryBefore Json?
  summaryAfter  Json?
  ip            String?  @db.VarChar(64)
  createdAt     DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("operation_logs")
}

model IdempotencyRecord {
  id           BigInt            @id @default(autoincrement())
  actorId      BigInt
  operation    String            @db.VarChar(100)
  key          String            @db.VarChar(100)
  requestHash  String            @db.VarChar(64)
  status       IdempotencyStatus @default(pending)
  responseJson Json?
  createdAt    DateTime          @default(now())
  completedAt  DateTime?

  @@unique([actorId, operation, key])
  @@index([status, createdAt])
  @@map("idempotency_records")
}

model EventOutbox {
  id          BigInt       @id @default(autoincrement())
  type        String       @db.VarChar(100)
  payloadJson Json
  status      OutboxStatus @default(pending)
  attempts    Int          @default(0)
  nextRetryAt DateTime?
  createdAt   DateTime     @default(now())
  deliveredAt DateTime?

  @@index([status, nextRetryAt])
  @@map("event_outbox")
}

model Notification {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @db.VarChar(100)
  title     String   @db.VarChar(200)
  body      String   @db.VarChar(2000)
  eventId   String?  @db.VarChar(60)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId, createdAt])
  @@map("notifications")
}
